---
interface Props { aktywny: 'start' | 'odziez' | 'materialy' }
const { aktywny } = Astro.props;
// Placebo Junior ma własny sklep w obrębie swojej wyspy (/placebo-junior/sklep/), więc nie ma go na tej liście.
const zakladki = [
  ['start', '/sklep/', 'Sklep'],
  ['odziez', '/sklep/odziez/', 'Odzież i torby'],
  ['materialy', '/sklep/materialy/', 'Materiały'],
];
---
<nav class="sklep-nav" aria-label="Sekcje sklepu">
  <div class="wrap">
    <ul>
      {zakladki.map(([id, href, nazwa]) => <li><a href={href} aria-current={id === aktywny ? 'page' : undefined}>{nazwa}</a></li>)}
    </ul>
    <span class="lvl sklep-status">Sklep w przygotowaniu</span>
  </div>
</nav>
