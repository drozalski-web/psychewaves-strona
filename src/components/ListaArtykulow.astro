---
import { artykuly, tematyWPrzygotowaniu } from '../lib/tresci';
interface Props { zKategoria?: boolean }
const { zKategoria = false } = Astro.props;
const posty = await artykuly();
const tematy = await tematyWPrzygotowaniu();
---
{posty.length > 0 && (
  <ul class="posts">
    {posty.map((a) => (
      <li class="post">
        <a href={`/artykuly/${a.id}/`}>
          <h3>{a.data.tytul}</h3>
          <span class="info">
            {a.data.szkic ? <span class="chip">Szkic</span> : <span class="chip">{a.data.kategoria}</span>}
            <span>· {a.data.czasCzytania} min</span>
          </span>
          <p>{a.data.zajawka}</p>
        </a>
      </li>
    ))}
  </ul>
)}
{tematy.length > 0 && (
  <div class="soon">
    <h3>Wkrótce</h3>
    <ul>
      {tematy.map((t) => (
        <li>{t.tytul}{zKategoria && t.kategoria && <span class="cat"> · {t.kategoria}</span>}</li>
      ))}
    </ul>
  </div>
)}
