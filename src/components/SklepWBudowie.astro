---
import Base from '../layouts/Base.astro';
import FormularzNewsletter from './FormularzNewsletter.astro';
import { MARKA_SKLEPU, SKLEP_PRZENIESIONY } from '../lib/witryna';
// Na stopsprawdzam.pl podpisujemy, która linia jest której marki (odzież: #stopsprawdzam, edukacja: Psyche Waves).
const powstaje = SKLEP_PRZENIESIONY
  ? [
      'Odzież #stopsprawdzam: koszulki, bluzy i torby z hasłami psychoedukacji bez wstydu',
      'Materiały do wydruku Psyche Waves do krytycznego czytania psychologii',
      'Linia Placebo Junior od Psyche Waves: karty pracy i maskotka Placebo',
    ]
  : [
      'Koszulki, bluzy i torby z hasłami psychoedukacji bez wstydu',
      'Materiały do wydruku do krytycznego czytania psychologii',
      'Linia Placebo Junior: karty pracy i maskotka Placebo',
    ];
---
<Base tytul="Sklep w budowie" opis={`Sklep ${MARKA_SKLEPU} jest w budowie. Zostaw e-mail, a dam Ci znać, gdy ruszy.`}>
  <div class="tasma" role="presentation" aria-hidden="true"></div>
  <section class="hero">
    <div class="wrap pl-hero junior-hero">
      <div class="pl-hero-text">
        <p class="eyebrow">Sklep {MARKA_SKLEPU}</p>
        <h1>Sklep w budowie</h1>
        <p class="lead">Placebo ogląda każdy szew i pyta, skąd wiemy, że się nie rozpruje. Otworzę sklep, gdy odpowiedź będzie brzmiała: wiemy. Daty nie podam, bo Placebo zapytałby, skąd ją mam.</p>
        <ul class="plain">
          {powstaje.map((p) => <li>{p}</li>)}
        </ul>
        <p class="muted">Na każdym produkcie jest znak <a href="/stopsprawdzam/">#stopsprawdzam</a>.</p>
        <div class="btns"><a class="btn primary" href="#zapis">Powiadom mnie o otwarciu</a><a class="btn" href="/publikacje/">Czytaj publikacje</a></div>
      </div>
      <img class="pl-hero-img junior" src="/placebo/h3-usmiech.webp" width="303" height="228" alt="Placebo w czapce EEG szeroko się uśmiecha z zamkniętymi oczami" fetchpriority="high">
    </div>
  </section>
  <div class="tasma" role="presentation" aria-hidden="true"></div>

  <section id="zapis">
    <div class="wrap">
      <div class="newsletter">
        <div>
          <p class="eyebrow">Powiadomienie o otwarciu</p>
          <h2 class="h-sec">Napiszę raz, gdy sklep ruszy</h2>
          <p class="muted" style="margin-top:10px">Jedna wiadomość, bez spamu. Adres wykorzystam wyłącznie do tego i usunę go na Twoją prośbę.</p>
        </div>
        <FormularzNewsletter nazwa="sklep-otwarcie" id="sw" />
      </div>
    </div>
  </section>
</Base>
