---
import Base from '../layouts/Base.astro';
import Separator from '../components/Separator.astro';
import FormularzNewsletter from '../components/FormularzNewsletter.astro';
import { produkty, grupy } from '../data/produkty';
---
<Base tytul="Linia Placebo" opis="Linia Placebo od Psyche Waves: materiały do krytycznego czytania psychologii, karty pracy i gadżety dla dzieci (Linia Placebo Junior). Pierwsza karta pracy jest darmowa.">
  <section class="article-head">
    <div class="wrap">
      <p class="eyebrow">Sklep</p>
      <h1>Linia Placebo</h1>
      <p class="standfirst">Materiały do krytycznego czytania psychologii, karty pracy i gadżety dla dzieci (Linia Placebo Junior) Psyche Waves. Zaczynamy od materiałów cyfrowych, bo da się je sprawdzić i poprawić, zanim cokolwiek trafi do druku.</p>
    </div>
  </section>

  <section>
    <div class="wrap">
      {grupy.map((g) => (
        <div class="shop-group" id={g.id}>
          <h2 class="h-sec">{g.nazwa}</h2>
          <p class="muted" style="margin-top:6px">{g.opis}</p>
          <ul class="shop">
            {produkty.filter((p) => p.grupa === g.id).map((p) => (
              <li class="item" id={p.id}>
                <div>
                  <p class="shop-type">{p.typ}</p>
                  <h3>{p.nazwa}</h3>
                  <p>{p.opis}</p>
                </div>
                <div class="shop-cta">
                  {p.status === 'dostepne'
                    ? <a class="btn primary" href={p.href} download>{p.darmowy ? 'Pobierz za darmo' : 'Pobierz'}</a>
                    : <span class="lvl">W przygotowaniu</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="tight" id="lista">
    <div class="wrap">
      <Separator />
      <p class="eyebrow">Lista oczekujących</p>
      <h2 class="h-sec">Daj znać, gdy pojawi się coś nowego</h2>
      <p class="muted" style="margin-top:10px">Jedna wiadomość, gdy będzie nowa karta pracy albo produkt. Bez spamu. Adres wykorzystam wyłącznie do tego i usunę go na Twoją prośbę.</p>
      <FormularzNewsletter nazwa="lista-placebo" id="wl" />
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <p class="note">Karty pracy są materiałem edukacyjnym dla dorosłych pracujących z dziećmi i nie są terapią ani diagnozą. Jeśli dziecko ma trudności, które Cię niepokoją, porozmawiaj ze specjalistą. Telefon Zaufania dla Dzieci i Młodzieży: 116 111.</p>
    </div>
  </section>
</Base>
