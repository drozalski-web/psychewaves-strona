---
import Base from '../layouts/Base.astro';
import Fala from '../components/Fala.astro';
import Separator from '../components/Separator.astro';
import ListaArtykulow from '../components/ListaArtykulow.astro';
const tematy = [
  ['Uzależnienia', 'Mechanizmy nagrody, nawroty, chemseks. Redukcja szkód zamiast moralizowania.'],
  ['ADHD', 'Uwaga, czas, emocje. Jak ADHD wygląda u dorosłych i dlaczego tak długo bywa niezauważone.'],
  ['Zaburzenia psychiczne', 'Borderline, zaburzenia afektywne, psychozy. Bez etykiet używanych jak obelgi.'],
  ['Relacje', 'Przywiązanie, granice, konflikt. Co dzieje się między ludźmi, kiedy jest trudno.'],
  ['EEG i biofeedback', 'Co naprawdę mierzą fale mózgowe, a czego o Tobie nie powiedzą. Bez obietnic cudów.'],
];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Psychoedukacja · Kraków</p>
      <h1>Psychoedukacja bez wstydu.</h1>
      <p class="lead">Piszę o tym, jak działa psychika, gdy coś zaczyna się sypać: uzależnienia, ADHD, zaburzenia psychiczne, relacje. Spokojnie, ze źródłami i bez oceniania.</p>
      <div class="btns">
        <a class="btn primary" href="/publikacje/">Czytaj publikacje</a>
        <a class="btn" href="/o-mnie/">Kim jestem</a>
      </div>
      <Fala klasa="hero-wave" opis="Fala EEG, która przechodzi z chaosu w spokój i kończy się kroplą wody" />
      <div class="meta"><span>Ze źródłami</span><span>Z poziomem pewności</span><span>Bez diagnoz przez internet</span></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Separator />
      <p class="eyebrow">O czym piszę</p>
      <h2 class="h-sec">Pięć tematów, do których wracam</h2>
      <div class="topics">
        {tematy.map(([t, o]) => (
          <div class="topic"><svg class="tag" viewBox="0 0 30 12" aria-hidden="true"><path d="M2 6 C6 1 10 1 14 6 S22 11 28 6" fill="none" stroke="#4FB3BF" stroke-width="3" stroke-linecap="round"/></svg><h3>{t}</h3><p>{o}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <p class="eyebrow">Najnowsze</p>
      <h2 class="h-sec">Publikacje</h2>
      <ListaArtykulow />
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <p class="eyebrow">Jak tu piszę</p>
      <div class="principles">
        <div><h3>Ze źródłami</h3><p>Każda publikacja kończy się bibliografią. Nie cytuję badań, których nie przeczytałem.</p></div>
        <div><h3>Z poziomem pewności</h3><p>Zaznaczam, co jest dobrze zbadane, a co jest dopiero hipotezą.</p>
          <div class="levels"><span class="lvl k">Wiemy</span><span class="lvl k">Badania sugerują</span><span class="lvl">Hipoteza</span></div></div>
        <div><h3>Bez wstydu</h3><p>Piszę o mechanizmach, nie o winie. Trudności psychiczne to nie wada charakteru.</p></div>
      </div>
    </div>
  </section>
</Base>
