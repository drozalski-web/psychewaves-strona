---
import Base from '../../layouts/Base.astro';
---
<Base tytul="Zapis potwierdzony" opis="Zapis na newsletter Psyche Waves jest potwierdzony." noindex>
  <section class="article-head">
    <div class="wrap">
      <p class="eyebrow">Newsletter</p>
      <h1>Zapis potwierdzony</h1>
      <p class="standfirst">Dziękuję. Napiszę, gdy pojawi się nowa publikacja. Rzadko i bez spamu.</p>
      <p class="muted" style="margin-top:12px">Wypisać się możesz w każdej chwili, klikając link w stopce wiadomości.</p>
      <div class="btns" style="margin-top:20px"><a class="btn primary" href="/publikacje/">Zobacz publikacje</a></div>
    </div>
  </section>
</Base>
