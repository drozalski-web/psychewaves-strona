---
import Base from '../../layouts/Base.astro';
import PanelPublikacji from '../../components/PanelPublikacji.astro';
import NewsletterBlok from '../../components/NewsletterBlok.astro';
---
<Base tytul="Publikacje" opis="Publikacje Psyche Waves dla dorosłych: uzależnienia, ADHD, zaburzenia psychiczne, relacje, EEG. Ze źródłami i poziomem pewności.">
  <section class="article-head">
    <div class="wrap">
      <p class="eyebrow">Dla dorosłych</p>
      <h1>Publikacje</h1>
      <p class="standfirst">Dłuższe wersje tematów z Instagrama, z mechanizmami, przykładami i pełną listą źródeł.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <PanelPublikacji odbiorca="dorosli" twarz="h2-sceptyk" eyebrow="Artykuły dla dorosłych" tytul="Ze źródłami i poziomem pewności" opis="Mechanizmy, przykłady i pełne listy źródeł. Przy każdej tezie Placebo pyta: skąd to wiemy?" />
    </div>
  </section>
  <NewsletterBlok id="np" />
</Base>
