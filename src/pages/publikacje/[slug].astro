---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { artykuly } from '../../lib/tresci';

export async function getStaticPaths() {
  const lista = await artykuly();
  return lista.map((a) => ({ params: { slug: a.id }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
const d = a.data;
const dataPl = d.data.toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base tytul={d.tytul} opis={d.zajawka}>
  {d.szkic && (
    <div class="draft" role="note"><div class="wrap"><strong>Szkic.</strong> Ta publikacja nie jest widoczna na żywej stronie, dopóki go nie zaakceptujesz.</div></div>
  )}
  <article>
    <header class="article-head">
      <div class="wrap narrow">
        <a href="/publikacje/" class="back">← Wszystkie publikacje</a>
        <p class="eyebrow" style="margin-top:20px">{d.kategoria}</p>
        <h1>{d.tytul}</h1>
        <p class="standfirst">{d.zajawka}</p>
        <div class="byline">
          <span>Daniel · Psyche Waves</span>
          <span>{dataPl}</span>
          <span>{d.czasCzytania} min czytania</span>
          {d.szkic && <span class="chip">Szkic · czeka na akceptację</span>}
        </div>
      </div>
    </header>
    <div class="prose wrap narrow">
      <Content />
      <div class="refs">
        <strong style="color:var(--ink)">Źródła</strong>
        {d.zrodlaDoWeryfikacji && <span class="todo">DO WERYFIKACJI</span>}
        {d.zrodla.length > 0 && <ol>{d.zrodla.map((z) => <li set:html={z} />)}</ol>}
        <p style="margin-top:14px">Treści edukacyjne; nie zastępują konsultacji ze specjalistą.</p>
      </div>
    </div>
  </article>
</Base>
